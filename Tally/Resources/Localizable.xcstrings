    "About Tally": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über Tally"
          }
        }
      }
    },
    "About": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Über"
          }
        }
      }
    },
    "Not downloaded yet": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch nicht geladen"
          }
        }
      }
    },
    "No active accounts": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine aktiven Konten"
          }
        }
      }
    },
    "Add an account before running an update.": {
      "extractionState": "manual",
      "localizations": {
