#!/bin/bash
# Runs a developer tool at the version pinned here, installing it on first use,
# so the pre-commit hook, CI, and anyone's Mac lint, format, and generate alike.
#
#   BuildTools/tool swift-format lint --strict --recursive Tally
#   BuildTools/tool swiftlint lint --strict
#   BuildTools/tool xcodegen generate
#
# Upgrading: for SwiftLint or XcodeGen, change the version and checksum below;
# for swift-format, the version in Package.swift, then `swift package update`
# in this directory. Commit any reformatting or new lint fixes with the bump.
set -euo pipefail

SWIFTLINT_VERSION=0.65.1
SWIFTLINT_SHA256=c1e429b0599cf1b516f369a2d9ec04eaf0e436f3c12b637df8851fa52ff694d0

XCODEGEN_VERSION=2.46.0
XCODEGEN_SHA256=4d9e34b62172d645eed6457cac13fc222569974098ef4ee9c3368bedf0196806

here="$(cd "$(dirname "$0")" && pwd)"
bin="$here/.bin"

# Downloads a release zip, checks it against the pinned SHA-256, and unpacks it
# into $bin/<dir>. A version bump changes <dir>, so it installs afresh.
install_zip() {
    local url=$1 sha256=$2 dir=$3
    [[ -d "$bin/$dir" ]] && return

    echo "Installing ${dir}…" >&2
    local tmp
    tmp="$(mktemp -d)"
    curl --fail --silent --show-error --location --retry 3 --output "$tmp/tool.zip" "$url"
    echo "$sha256  $tmp/tool.zip" | shasum --algorithm 256 --check --status || {
        echo "error: $url does not match its pinned checksum" >&2
        exit 1
    }
    unzip -q "$tmp/tool.zip" -d "$tmp/unpacked"
    mkdir -p "$bin"
    mv "$tmp/unpacked" "$bin/$dir"
    rm -rf "$tmp"
}

# Builds swift-format from Package.swift, and again only when the pin changes.
build_swift_format() {
    local stamp="$here/.build/swift-format.stamp"
    local pin
    pin="$(cat "$here/Package.swift" "$here/Package.resolved" | shasum --algorithm 256)"
    [[ -f "$stamp" && "$(cat "$stamp")" == "$pin" ]] && return

    echo "Building the pinned swift-format; this takes a few minutes, once…" >&2
    swift build --configuration release --package-path "$here" --product swift-format >&2
    echo "$pin" >"$stamp"
}

tool="${1:-}"
[[ $# -gt 0 ]] && shift

case "$tool" in
swift-format)
    build_swift_format
    exec "$here/.build/release/swift-format" "$@"
    ;;
swiftlint)
    install_zip \
        "https://github.com/realm/SwiftLint/releases/download/$SWIFTLINT_VERSION/portable_swiftlint.zip" \
        "$SWIFTLINT_SHA256" "swiftlint-$SWIFTLINT_VERSION"
    exec "$bin/swiftlint-$SWIFTLINT_VERSION/swiftlint" "$@"
    ;;
xcodegen)
    install_zip \
        "https://github.com/yonaskolb/XcodeGen/releases/download/$XCODEGEN_VERSION/xcodegen.zip" \
        "$XCODEGEN_SHA256" "xcodegen-$XCODEGEN_VERSION"
    exec "$bin/xcodegen-$XCODEGEN_VERSION/xcodegen/bin/xcodegen" "$@"
    ;;
*)
    echo "usage: BuildTools/tool swift-format|swiftlint|xcodegen [arguments…]" >&2
    exit 64
    ;;
esac
